    {
      "name": "6. Headless Soru Bankası & Mobil Quiz Servisi (Anti-Cheat & 0ms Cache)",
      "item": [
        {
          "name": "Bölüm Quizi Getir (200 havuzdan / 202 hazırlanıyor)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/quiz/serve?book_id=1661&chapter_index=1&count=5&difficulty=medium&hide_answers=true",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "quiz",
                "serve"
              ],
              "query": [
                {
                  "key": "book_id",
                  "value": "1661",
                  "description": "Kitap ID'si"
                },
                {
                  "key": "chapter_index",
                  "value": "1",
                  "description": "1-tabanlı bölüm numarası"
                },
                {
                  "key": "count",
                  "value": "5",
                  "description": "İstenen soru sayısı (1-20)"
                },
                {
                  "key": "difficulty",
                  "value": "medium",
                  "description": "easy | medium | hard"
                },
                {
                  "key": "hide_answers",
                  "value": "true",
                  "description": "Hile koruması: true olduğunda correct_answer ve explanation null döner"
                }
              ]
            },
            "description": "Havuzda yeterli doğrulanmış soru varsa 200 ve sorular. Yoksa 202: havuzu dolduran iş kuyruğa alınır, yanıttaki job_id ile 'İş Durumu' isteği yoklanır, iş completed olunca bu istek tekrarlanır. Bu uç LLM çağırmaz."
          },
          "response": []
        },
        {
          "name": "Hile Korumalı Cevap Değerlendirme (Soru ID Bazlı)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"question_id\": 1,\n      \"selected_option\": \"A) Baker Street 221B\"\n    },\n    {\n      \"question_id\": 2,\n      \"selected_option\": \"B\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/quiz/evaluate-answers",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "quiz",
                "evaluate-answers"
