            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_answers\": [\n    {\n      \"question_index\": 0,\n      \"selected_option\": \"A) Baker Street 221B\"\n    },\n    {\n      \"question_index\": 1,\n      \"selected_option\": \"B) Moriarty\"\n    }\n  ],\n  \"quiz\": [\n    {\n      \"question\": \"Sherlock Holmes nerede yaşamaktadır?\",\n      \"options\": [\n        \"A) Baker Street 221B\",\n        \"B) Oxford Street 12\",\n        \"C) Fleet Street 4\",\n        \"D) Abbey Road 10\"\n      ],\n      \"correct_answer\": \"A\",\n      \"explanation\": \"Holmes ve Dr. Watson, Baker Street 221B adresinde ikamet etmektedir.\",\n      \"source_pages\": [1]\n    },\n    {\n      \"question\": \"Sherlock Holmes'un en yakın çalışma arkadaşı ve biyografi yazarı kimdir?\",\n      \"options\": [\n        \"A) Dedektif Lestrade\",\n        \"B) Dr. John H. Watson\",\n        \"C) Profesör Moriarty\",\n        \"D) Mycroft Holmes\"\n      ],\n      \"correct_answer\": \"B\",\n      \"explanation\": \"Dr. John Watson, Holmes'un kadim dostu ve olayları kaleme alan kişidir.\",\n      \"source_pages\": [2]\n    }\n  ]\n}"
